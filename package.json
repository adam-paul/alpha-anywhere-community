{
  "name": "alpha-anywhere-community",
  "version": "0.1.0",
  "workspaces": [
    "infra/lwai-proxy"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:cf": "vite build && wrangler pages dev .svelte-kit/cloudflare --port 6173",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:migrate": "wrangler d1 migrations apply alpha-community --local",
    "db:migrate:remote": "wrangler d1 migrations apply alpha-community --remote",
    "db:migrate:status": "wrangler d1 migrations list alpha-community --local",
    "db:migrate:status:remote": "wrangler d1 migrations list alpha-community --remote",
    "db:seed": "bun run scripts/seed-games.ts",
    "db:seed:remote": "bun run scripts/seed-games.ts --remote",
    "db:seed:clear": "bun run scripts/seed-games.ts --clear",
    "db:seed:remote:clear": "bun run scripts/seed-games.ts --remote --clear"
  },
  "lint-staged": {
    "*.{js,ts,svelte,css,md,json}": "prettier --write"
  },
  "type": "module",
  "dependencies": {
    "@timeback/edubridge": "^0.1.5",
    "@timeback/sdk": "0.1.4",
    "wrangler": "^4.71.0"
  }
}
